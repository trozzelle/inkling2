# scripts/studio/local.env.example: copy to scripts/studio/local.env (gitignored) and edit. Plain VAR=value lines.
# ssh host of the inference Mac (an alias from ~/.ssh/config).
STUDIO_HOST=inference-mac
# This repo's checkout on that Mac (sync.sh copies the tree there).
STUDIO_REPO=/path/on/inference-mac/to/inkling2
# Fast working directory on that Mac: TensorFold pack and fork build, kortexa decode, gate data.
INK2Q_WORK=/path/on/inference-mac/to/inkling2-work
# Bulk data root on that Mac: source checkpoint, models, teacher finals, reports.
INK2Q_ROOT=/path/on/inference-mac/to/inkling2-data
# studio-inference workspace on that Mac (default: $HOME/studio-inference).
STUDIO_HOME=/path/on/inference-mac/to/studio-inference
# uv binary on that Mac (default: uv on PATH; ssh sessions often lack the Homebrew PATH).
UV=/path/on/inference-mac/to/uv
# oMLX virtualenv bin directory on that Mac (omlx_teacher_baseline.sh, omlx_baseline_rerun.sh); keep it on an internal disk, not exFAT.
OMLX_BIN=/path/on/inference-mac/to/omlx/.venv/bin
# Hosts the served TensorFold engine accepts (tf_router_repro.sh), space separated.
STUDIO_ALLOWED_HOSTS="inference-mac.local 192.0.2.10"
